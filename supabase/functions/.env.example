# Secrets for the extract-letter function. Copy to supabase/functions/.env (git-ignored).
# Local: `npm run functions:dev`. Production: `npx supabase secrets set --env-file supabase/functions/.env`.

# Data mode: set exactly one.
#   DEV_MODE_SYNTHETIC_ONLY=true        free-tier LLM, synthetic test letters only (app shows a banner)
#   LLM_APPROVED_FOR_PERSONAL_DATA=true  EU, no-training LLM configuration, approved for real letters
DEV_MODE_SYNTHETIC_ONLY=true

# LLM provider: gemini | mistral | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
