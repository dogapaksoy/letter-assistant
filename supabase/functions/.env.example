# Secrets for the extract-letter function. Copy to supabase/functions/.env (git-ignored).
# Local: `npm run functions:dev`. Production: `npx supabase secrets set --env-file supabase/functions/.env`.

# Data mode: set exactly one.
#   DEV_MODE_SYNTHETIC_ONLY=true        free-tier LLM, synthetic test letters only (app shows a banner)
#   LLM_APPROVED_FOR_PERSONAL_DATA=true  EU, no-training LLM configuration, approved for real letters
DEV_MODE_SYNTHETIC_ONLY=true

# LLM provider: gemini | mistral | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Text recognition for photos and scanned PDFs (without it: ocr_not_configured).
# Azure AI Document Intelligence resource in an EU region (e.g. Germany West Central):
# Azure portal -> the resource -> Keys and Endpoint.
# OCR_PROVIDER=azure
# AZURE_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_DI_KEY=

# Rate limiting (required when LLM_APPROVED_FOR_PERSONAL_DATA=true, optional in dev mode).
# Needs the rate_limit migration (npx supabase db push). SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are provided by Supabase in deployed functions; set
# RATE_LIMIT_DB_KEY to a secret key (sb_secret_...) if legacy keys are disabled.
# RATE_LIMIT_SECRET: a long random string used to hash client IPs (IPs are never stored).
RATE_LIMIT_SECRET=
# RATE_LIMIT_PER_CLIENT_PER_HOUR=10
# RATE_LIMIT_GLOBAL_PER_HOUR=200
# RATE_LIMIT_DB_KEY=
