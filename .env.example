# Copy this file to .env and fill in the values. .env is git-ignored.
#
# Supabase dashboard -> Project Settings -> API Keys (or the "Connect" button).
# Everything prefixed EXPO_PUBLIC_ is bundled into the app and readable by anyone,
# so only the publishable (or legacy anon) key belongs here. NEVER put the secret /
# service_role key in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
