# Copy to .env.eval (git-ignored) for `npm run eval`. Never commit real keys.
# Used only by the local eval script; not bundled into the app.
# The runner uses the first provider whose key is set (gemini, mistral, anthropic),
# or pick one with --provider.
# Free plans may use inputs for training: synthetic letters only.

# Google Gemini: aistudio.google.com -> Get API key. Optional: GEMINI_MODEL=...
GEMINI_API_KEY=

# Mistral: console.mistral.ai -> API Keys (API access needs a paid plan).
MISTRAL_API_KEY=

# Anthropic: console.anthropic.com -> API Keys (paid).
ANTHROPIC_API_KEY=
